# Orar Univer on serverhome — copy to /srv/apps/time-university/.env and `chmod 600 .env`.
# Single file: docker-compose reads it for ${...} interpolation in compose.yaml. The API container
# gets ONLY the variables listed under `environment:` in compose.yaml (the DB password never
# reaches it) — a new application variable must be added there too. Never commit the real .env.
#
# NODE_ENV, PORT, HOST, DATABASE_PATH and DATABASE_URL are forced by compose.yaml.
# Values are interpolated by compose: write a literal `$` as `$$`.

# ---- PostgreSQL (Teacher Catalog) ------------------------------------------------------
# REQUIRED. URL-safe characters only (it is embedded in DATABASE_URL):  openssl rand -hex 24
# Applied only when data/postgres is first initialised. To change it later:
#   docker exec time-university-db psql -U orar -d orar -c "ALTER USER orar PASSWORD '<new>';"
POSTGRES_PASSWORD=
POSTGRES_USER=orar
POSTGRES_DB=orar

# ---- Telegram ----------------------------------------------------------------------------
# REQUIRED. Token from @BotFather. One running instance per token (polling gets 409 otherwise).
TELEGRAM_BOT_TOKEN=
MINI_APP_URL=https://time-university.sma1lsoft.eu
# Update delivery, EXACTLY ONE mode:
#  - polling (default here): TELEGRAM_POLLING=true, WEBHOOK_URL empty
#  - webhook: TELEGRAM_POLLING=false,
#             WEBHOOK_URL=https://time-university.sma1lsoft.eu/telegram/webhook
#             TELEGRAM_WEBHOOK_SECRET=<openssl rand -hex 32>
TELEGRAM_POLLING=true
WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Max age of Telegram initData accepted by the API, seconds (60..604800).
# initData is a bearer credential with no revocation, so keep this window short.
INIT_DATA_MAX_AGE_SECONDS=3600

# ---- Academic calendar -----------------------------------------------------------------------
# Teaching periods: START:even|odd[:END], comma separated. START must be a MONDAY and sets that
# first week's parity; parity and week numbering restart at every semester. END is inclusive and
# may be omitted only on the last entry; semesters must not overlap. Outside every semester the
# lessons stay visible but no reminder is sent. An invalid value stops the API at startup.
# Empty = the previous behaviour (one open-ended semester from 2026-09-07, even week).
#   SEMESTERS=2026-09-07:even:2026-12-20,2027-02-01:even:2027-05-30
SEMESTERS=

# ---- HTTP / security -----------------------------------------------------------------------
ALLOWED_ORIGINS=https://time-university.sma1lsoft.eu
# Express "trust proxy": loopback + private networks (nginx_proxy -> web -> api are all private).
TRUST_PROXY=loopback, linklocal, uniquelocal
# Per-client API requests per minute (0 disables).
RATE_LIMIT_PER_MINUTE=120
# Must stay false in production (the API refuses to start otherwise).
ALLOW_DEV_AUTH=false

# ---- Backups (deploy/serverhome/backup.sh) -------------------------------------------------
BACKUP_RETENTION_DAYS=14
