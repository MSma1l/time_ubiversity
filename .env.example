# Docker Compose variables — copy to .env (next to docker-compose.yml). Never commit .env.
# Application secrets (bot token, URLs) live in backend/.env.

# ---- PostgreSQL (Teacher Catalog) --------------------------------------------------
# REQUIRED. Use URL-safe characters only (it is embedded in DATABASE_URL):
#   openssl rand -hex 24
# NOTE: the password is applied only when the postgres volume is first created.
# To change it on an existing volume:
#   docker compose exec postgres psql -U orar -d orar -c "ALTER USER orar PASSWORD '<new>';"
POSTGRES_PASSWORD=
POSTGRES_USER=orar
POSTGRES_DB=orar

# ---- Web (nginx) ---------------------------------------------------------------------
# Host port for the Mini App; the host HTTPS proxy forwards to 127.0.0.1:WEB_PORT.
WEB_PORT=8083
# Keep 127.0.0.1 in production (only the local reverse proxy may connect).
WEB_BIND=127.0.0.1

# ---- Optional ------------------------------------------------------------------------
# Pin the compose project name (volume names become <name>_orar-data, <name>_postgres-data).
# COMPOSE_PROJECT_NAME=orar-univer
# Backups (deploy/backup.sh)
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=14
