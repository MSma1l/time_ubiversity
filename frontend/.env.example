# Orar Univer — Mini App (Vite). Copy to frontend/.env.local for local development.
# Only variables prefixed with VITE_ reach the browser bundle, and they are INLINED at build
# time (`npm run build`), not read at runtime: never put a secret here. All three are optional.

# ---- API base URL -------------------------------------------------------------------------
# Leave EMPTY in production: nginx serves the app and the API on the same origin (/api, /telegram),
# so relative requests need no CORS. Set it only when the frontend is served from another origin
# (then add that origin to ALLOWED_ORIGINS in backend/.env). No trailing slash.
# In Docker the value is passed as a build arg in frontend/Dockerfile (ARG VITE_API_URL).
# VITE_API_URL=

# ---- Local development without Telegram ---------------------------------------------------
# Numeric Telegram user id used for dev authentication, honoured ONLY by the Vite dev server
# (import.meta.env.DEV) and ignored in a production build. The API must run with
# ALLOW_DEV_AUTH=true, which it refuses in production.
# VITE_DEV_TELEGRAM_ID=123456789

# ---- Demo mode --------------------------------------------------------------------------------
# "true" makes a production build start with sample data, without Telegram and without syncing
# anything to the server (useful for a UI preview). Leave unset for a real deployment.
# VITE_DEMO_MODE=false
