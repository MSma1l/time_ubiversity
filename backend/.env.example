# Orar Univer API — copy to backend/.env and fill in. Never commit backend/.env.
#
# With Docker Compose, NODE_ENV, PORT, DATABASE_PATH and DATABASE_URL are set in
# docker-compose.yml and OVERRIDE the values below (DATABASE_URL is built from
# POSTGRES_* in the root .env). The values here are for running the API locally.

# ---- Runtime -----------------------------------------------------------------
# "production" enables strict config validation (token required, dev auth forbidden).
NODE_ENV=production
PORT=3001
# Interface to listen on (0.0.0.0 inside Docker).
HOST=0.0.0.0

# ---- Telegram ------------------------------------------------------------------
# Secret token issued by @BotFather. Required when NODE_ENV=production.
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL of the Mini App (the domain served by deploy/Caddyfile).
# Used for the "Open" button in /start and in reminders.
MINI_APP_URL=https://orar.example.md
# Update delivery. Use EXACTLY ONE mode per bot token:
#  - polling (simplest, no public webhook needed): TELEGRAM_POLLING=true
#  - webhook: TELEGRAM_POLLING=false, WEBHOOK_URL=https://<domain>/telegram/webhook
#    and TELEGRAM_WEBHOOK_SECRET (sent by Telegram in X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_POLLING=true
WEBHOOK_URL=
# Generate with: openssl rand -hex 32   (allowed chars: A-Z a-z 0-9 _ -)
TELEGRAM_WEBHOOK_SECRET=
# Maximum age of Telegram initData accepted by the API, in seconds (60..604800).
# initData is a bearer credential with no revocation, so keep this window short.
INIT_DATA_MAX_AGE_SECONDS=3600

# ---- Academic calendar -------------------------------------------------------------
# Teaching periods, in order: START:even|odd[:END], comma separated. START must be a MONDAY
# (the first Monday of the semester) and gives that first week's parity; weeks 1, 3, 5 ... keep
# it, weeks 2, 4, 6 ... get the other one. Parity and week numbering RESTART at every semester,
# so the winter break cannot consume parity and invert the second semester. END is inclusive and
# may be omitted only on the LAST entry (an open-ended semester swallows everything after it);
# semesters must not overlap. Dates outside every semester are non-teaching: lessons stay visible,
# only the reminders go silent. A bad value is refused at startup (backend/src/config.ts).
# Empty = the built-in default, one open-ended semester starting 2026-09-07 on an even week —
# exactly the behaviour from before this variable existed.
#   SEMESTERS=2026-09-07:even:2026-12-20,2027-02-01:even:2027-05-30
SEMESTERS=

# ---- HTTP / security ---------------------------------------------------------------
# Comma-separated origins allowed by CORS (no trailing slash). Usually = MINI_APP_URL.
ALLOWED_ORIGINS=https://orar.example.md
# Express "trust proxy". Default trusts loopback + private networks (nginx in Docker).
TRUST_PROXY=loopback, linklocal, uniquelocal
# Per-client API request limit per minute (0 disables).
RATE_LIMIT_PER_MINUTE=120
# Only for local UI development without Telegram. Refused when NODE_ENV=production.
ALLOW_DEV_AUTH=false

# ---- Storage (local runs only; Docker overrides these) ----------------------------
# SQLite file: profiles, lessons, notifications. In Docker: /data/orar.sqlite (volume).
DATABASE_PATH=./data/orar.sqlite
# PostgreSQL for the Teacher Catalog. In Docker: built from the root .env.
# Local example with docker-compose.dev.yml: postgresql://orar:<password>@127.0.0.1:55434/orar
DATABASE_URL=

# ---- Tests (optional) ---------------------------------------------------------------------
# OPTIONAL, tests only: PostgreSQL used by the Teacher Catalog tests (src/catalog.test.ts).
# Without it those tests are skipped; the rest of the suite runs without PostgreSQL.
# The test database is written to and cleaned up — never point it at production.
#   DATABASE_URL_TEST=postgresql://orar:<password>@127.0.0.1:55434/orar
DATABASE_URL_TEST=
